# Lovable Cloud (auto-populated — do not edit .env directly)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Edge Function Secrets (set via Lovable Cloud > Secrets)
# OPENAI_API_KEY=          # OpenAI — embeddings & AI agents
# PINECONE_API_KEY=        # Pinecone — vector DB operations
# PINECONE_INDEX_HOST=     # Pinecone — index endpoint URL
# NEO4J_URI=               # Neo4j Aura — graph database connection
# NEO4J_USERNAME=          # Neo4j Aura — auth username
# NEO4J_PASSWORD=          # Neo4j Aura — auth password
# SLACK_CLIENT_ID=         # Slack API — OAuth flow
# SLACK_CLIENT_SECRET=     # Slack API — OAuth flow
# SLACK_SIGNING_SECRET=    # Slack API — webhook verification
# GOOGLE_CLIENT_ID=        # Google Cloud — Gmail/Calendar OAuth
# GOOGLE_CLIENT_SECRET=    # Google Cloud — Gmail/Calendar OAuth
